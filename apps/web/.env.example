# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/block_lock?schema=public"

# Redis (Upstash REST API: lib/redis.ts uses @upstash/redis, which talks HTTPS,
# not a redis:// connection string). Copy the REST URL and the read-write REST
# token from the Upstash console. Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead (with any prefix chosen when
# connecting it); those are read too, so on Vercel you can leave these unset.
UPSTASH_REDIS_REST_URL=""   # https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=""

# Auth.js
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""   # generate with: openssl rand -base64 32

# OAuth providers (Auth.js auto-detects AUTH_<PROVIDER>_ID / AUTH_<PROVIDER>_SECRET)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI SDK (natural-language scheduling, /api/ai/schedule; semantic classification,
# /api/classify; productivity coach briefings, /api/cron/insights)
OPENAI_API_KEY=""

# Authorizes Vercel Cron to trigger /api/cron/insights (Vercel sends this value
# as `Authorization: Bearer <CRON_SECRET>` automatically — see vercel.json)
CRON_SECRET=""

# Published Chrome extension ID. Used to push live updates to the extension
# (components/extension-bridge.tsx) and to allow-list its chrome-extension://
# origin for CORS on /api/sync and /api/analytics (lib/cors.ts).
NEXT_PUBLIC_EXTENSION_ID=""

